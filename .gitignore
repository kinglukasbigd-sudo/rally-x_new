build/
*.o
*.d

# Vendored SDL: staged by tools/fetch_sdl2.sh (desktop headers) and
# tools/fetch_sdl2_android.sh (full source for the Android build).
third_party/

# Android
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/local.properties
*.apk
*.keystore

# Python bytecode from the tools
__pycache__/
*.pyc

# Player-supplied music. Whatever anyone drops in here is theirs, and must
# never be committed or shipped in the APK.
music/

# The local score database, written at runtime. It belongs to whoever played,
# and lives outside the project anyway -- this only catches a stray copy.
scores.dat
scores.dat.tmp
